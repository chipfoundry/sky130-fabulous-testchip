# PCF for classic_fabric_chipfoundry_small
# Source: classic_fabric_chipfoundry_small.csv (6x8 grid: X0-X5, Y0-Y7)
#
# Rationale for remapping from the original large-fabric template:
#   The small fabric is a 6-column x 8-row grid. Valid IOBUF tiles are:
#     - Left  (W_IO2): X0Y1 through X0Y6, each with /A and /B ports = 12 pins
#     - Right (E_IO2): X5Y1 through X5Y6, each with /A and /B ports = 12 pins
#     - Total: 24 available IO pins
#   The original template (a copy of the large-fabric file) referenced:
#     - N-term row coordinates like X1Y9 (does not exist in this fabric, max Y=7)
#     - S-term row Y=0 (termination tile, no IOBUF)
#     - Interior LUT tile columns X1-X4 (type FABULOUS_LC, not IOBUF)
#   nextpnr rejected these with "bel type 'FABULOUS_LC' does not match IO cell"
#   and "Assertion failure: no bel named X*Y*/A".
#   All pins below map exclusively to the 24 valid W_IO2 (X0) / E_IO2 (X5) slots.

# All I/Os (24 total: 12 left + 12 right)
set_io all[0]  X0Y1/A
set_io all[1]  X0Y2/A
set_io all[2]  X0Y3/A
set_io all[3]  X0Y4/A
set_io all[4]  X0Y5/A
set_io all[5]  X0Y6/A
set_io all[6]  X0Y1/B
set_io all[7]  X0Y2/B
set_io all[8]  X0Y3/B
set_io all[9]  X0Y4/B
set_io all[10] X0Y5/B
set_io all[11] X0Y6/B
set_io all[12] X5Y1/A
set_io all[13] X5Y2/A
set_io all[14] X5Y3/A
set_io all[15] X5Y4/A
set_io all[16] X5Y5/A
set_io all[17] X5Y6/A
set_io all[18] X5Y1/B
set_io all[19] X5Y2/B
set_io all[20] X5Y3/B
set_io all[21] X5Y4/B
set_io all[22] X5Y5/B
set_io all[23] X5Y6/B

# For general tests (counter, addition, multiplication, passthrough, etc.)
# Inputs on left side (X0), outputs on right side (X5)
set_io clk1 X0Y1/A
set_io clk2 X0Y2/A
set_io ena  X0Y3/A
set_io rst  X0Y4/A

set_io e[0] X0Y5/A
set_io e[1] X0Y6/A
set_io e[2] X0Y1/B
set_io e[3] X0Y2/B

# a[0:5] - 6-bit input port (e.g. addition, multiplication)
# Placed on left-side B-ports (X0Y1/B - X0Y6/B); no conflict with c[] on right side.
set_io a[0] X0Y1/B
set_io a[1] X0Y2/B
set_io a[2] X0Y3/B
set_io a[3] X0Y4/B
set_io a[4] X0Y5/B
set_io a[5] X0Y6/B

# b[0:5] - 6-bit input port
# Placed on left-side A-ports (X0Y1/A - X0Y6/A); kept entirely on left so it
# never overlaps with c[] which occupies the right side (X5).
set_io b[0] X0Y1/A
set_io b[1] X0Y2/A
set_io b[2] X0Y3/A
set_io b[3] X0Y4/A
set_io b[4] X0Y5/A
set_io b[5] X0Y6/A

# c[0:7] - 8-bit output port (counter, addition)
# All 8 pins on the right side (X5). Rows Y1-Y6 A-ports give 6 pins;
# rows Y1/Y2 B-ports supply the remaining 2.
set_io c[0] X5Y1/A
set_io c[1] X5Y2/A
set_io c[2] X5Y3/A
set_io c[3] X5Y4/A
set_io c[4] X5Y5/A
set_io c[5] X5Y6/A
set_io c[6] X5Y1/B
set_io c[7] X5Y2/B

# For the register_file and ram_32x4_2r_1w test
#
# Small fabric IO columns: X0 (W_IO2, Y1-Y6) and X5 (E_IO2, Y1-Y6)
# Total available: 24 IO bels. The full RAM design needs 26 IOBUFs + 2 GBUFs.
# The assignments below are collision-free within valid IO columns; nextpnr will
# report a resource exhaustion error if the design truly needs more bels than exist.
#
# clk1/clk2 will use GBUF so they do not consume IOBUF bels here.
#
# addr_a[0:4] - 5-bit read address A → left B-ports Y1-Y5
# (same bels as a[] but a[] is only used in addition/counter, not RAM builds)
set_io addr_a[0] X0Y1/B
set_io addr_a[1] X0Y2/B
set_io addr_a[2] X0Y3/B
set_io addr_a[3] X0Y4/B
set_io addr_a[4] X0Y5/B

# addr_b[0:4] - 5-bit read address B → right A-ports Y3-Y6, then right B Y3
set_io addr_b[0] X5Y3/A
set_io addr_b[1] X5Y4/A
set_io addr_b[2] X5Y5/A
set_io addr_b[3] X5Y6/A
set_io addr_b[4] X5Y3/B

# addr_c[0:4] - 5-bit write address → right B Y4-Y6 + left B Y6 + left A Y1
set_io addr_c[0] X5Y4/B
set_io addr_c[1] X5Y5/B
set_io addr_c[2] X5Y6/B
set_io addr_c[3] X0Y6/B
set_io addr_c[4] X0Y1/A

# word_a[0:3] - 4-bit write data → left A-ports Y2-Y5
set_io word_a[0] X0Y2/A
set_io word_a[1] X0Y3/A
set_io word_a[2] X0Y4/A
set_io word_a[3] X0Y5/A

# word_b[0:3] - 4-bit read data A → right A Y1-Y2, right B Y1-Y2
set_io word_b[0] X5Y1/A
set_io word_b[1] X5Y2/A
set_io word_b[2] X5Y1/B
set_io word_b[3] X5Y2/B

# word_c[0:3] - 4-bit read data B → best-effort (fabric may exhaust at 24 bels)
set_io word_c[0] X0Y6/A
set_io word_c[1] X5Y3/B
set_io word_c[2] X5Y4/B
set_io word_c[3] X5Y5/B

# For the macc_8x8_20 test (12-bit product output)
# When building macc_8x8_20, addr_* are unused; right side Y1-Y6 A+B gives 12 bels.
set_io product[0]  X5Y1/A
set_io product[1]  X5Y2/A
set_io product[2]  X5Y3/A
set_io product[3]  X5Y4/A
set_io product[4]  X5Y5/A
set_io product[5]  X5Y6/A
set_io product[6]  X5Y1/B
set_io product[7]  X5Y2/B
set_io product[8]  X0Y5/A
set_io product[9]  X0Y6/A
set_io product[10] X0Y1/B
set_io product[11] X0Y2/B

