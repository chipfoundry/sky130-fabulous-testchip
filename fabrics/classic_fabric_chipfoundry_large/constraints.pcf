# For the register_file and ram_32x4_2r_1w test
#
# Large fabric IO columns: X0 (W_IO2, Y1-Y12) and X14 (E_IO2, Y1-Y12)
# X0 occupancy: clk1/clk2=Y1, ena/rst=Y2, e[]=Y3-Y4, a[]=Y5-Y7, b[]=Y8-Y10, c[0-3]=Y11-Y12
# X14 occupancy: c[4-7]=Y1-Y2. Rows Y3-Y12 on X14 (20 bels) are free for RAM/MACC ports.
#
# addr_a[0:4] - 5-bit read address A → X14 Y3-Y5 A/B (5 bels)
set_io addr_a[0] X14Y3/A
set_io addr_a[1] X14Y3/B
set_io addr_a[2] X14Y4/A
set_io addr_a[3] X14Y4/B
set_io addr_a[4] X14Y5/A

# addr_b[0:4] - 5-bit read address B → X14 Y5/B-Y7/B (5 bels)
set_io addr_b[0] X14Y5/B
set_io addr_b[1] X14Y6/A
set_io addr_b[2] X14Y6/B
set_io addr_b[3] X14Y7/A
set_io addr_b[4] X14Y7/B

# addr_c[0:4] - 5-bit write address → X14 Y8-Y10 A/B (5 bels)
set_io addr_c[0] X14Y8/A
set_io addr_c[1] X14Y8/B
set_io addr_c[2] X14Y9/A
set_io addr_c[3] X14Y9/B
set_io addr_c[4] X14Y10/A

# word_a[0:3] - 4-bit write data (input) → reuse left side X0Y5-Y6 A/B (4 bels, same as a[0:3])
# NOTE: word_a shares pins with a[]. Only use this block when building ram_32x4_2r_1w
# (addition/counter use a[] instead). This is intentional per-design PCF reuse.
set_io word_a[0] X0Y5/A
set_io word_a[1] X0Y5/B
set_io word_a[2] X0Y6/A
set_io word_a[3] X0Y6/B

# word_b[0:3] - 4-bit read data A (output) → X14 Y10/B-Y12/A (4 bels)
set_io word_b[0] X14Y10/B
set_io word_b[1] X14Y11/A
set_io word_b[2] X14Y11/B
set_io word_b[3] X14Y12/A

# word_c[0:3] - 4-bit read data B (output) → X14 Y12/B + X0Y7 A/B + X0Y8/A (4 bels)
# Use remaining free X0 bels that are not needed for counter/addition when building RAM.
set_io word_c[0] X14Y12/B
set_io word_c[1] X0Y7/A
set_io word_c[2] X0Y7/B
set_io word_c[3] X0Y8/A

# For the macc_8x8_20 test
# product[0:11] - 12-bit accumulator output → X14 Y3-Y9 A+B (12 bels, no overlap with addr pins)
# When building macc_8x8_20, addr_* are unused so Y3-Y9 on X14 are all free.
set_io product[0]  X14Y3/A
set_io product[1]  X14Y3/B
set_io product[2]  X14Y4/A
set_io product[3]  X14Y4/B
set_io product[4]  X14Y5/A
set_io product[5]  X14Y5/B
set_io product[6]  X14Y6/A
set_io product[7]  X14Y6/B
set_io product[8]  X14Y7/A
set_io product[9]  X14Y7/B
set_io product[10] X14Y8/A
set_io product[11] X14Y8/B
